# Environment Variables for Vera Bot

# Required: Get your free Groq API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override model (default: llama-3.3-70b-versatile)
# Options: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Override port (default: 8080)
PORT=8080
