# Environment Variables for Vera Bot

# Required: Get your free Groq API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override model (default: openai/gpt-oss-120b)
# llama-3.3-70b-versatile / llama-3.1-8b-instant are no longer available on Groq's
# catalog. openai/gpt-oss-120b and openai/gpt-oss-20b are reasoning models — composer.py
# already caps reasoning_effort="low" and sizes max_tokens accordingly; if you change
# GROQ_MODEL to a non-"gpt-oss" model, reasoning_effort is skipped automatically.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: OpenAI fallback. This Groq key's TPM budget is shared across all models on
# the account (8000 tokens/min org-wide) — under concurrent /v1/tick load, composer.py
# retries once on a 429 and then falls back to OpenAI if this key is set. Leave blank to
# keep Groq-only behavior (a persistent Groq failure just propagates as before).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Override port (default: 8080)
PORT=8080
